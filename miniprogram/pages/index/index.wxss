/**index.wxss - 咖啡冲煮计时器 **/

/* ==================== 全局基础 ==================== */
page {
  height: 100vh;
  background-color: #FAF7F2;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
}

.scrollarea {
  height: 100vh;
  padding-bottom: 180rpx;
}

/* ==================== 配置视图容器 ==================== */
.config-container {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ==================== 头部 ==================== */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 16rpx 0;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A3018;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: #8D6E63;
}

/* ==================== 卡片通用 ==================== */
.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(74, 48, 24, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A3018;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #F5F0E8;
}

/* ==================== 大师配方锁定状态 ==================== */
.form-row-locked {
  opacity: 0.55;
  pointer-events: none;
}

.picker-value-locked {
  background-color: #EDE7E3;
  color: #A09080;
}

/* ==================== 深烘预警 ==================== */
.roast-warning {
  margin: 0 0 8rpx 0;
  padding: 20rpx 28rpx;
  background-color: #FFF3E0;
  border-left: 6rpx solid #E65100;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #BF360C;
  line-height: 1.7;
}

/* ==================== 大师配方预设卡片 ==================== */
.preset-card {
  border: 2rpx solid #D7CCC8;
}

.preset-lock-badge {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  background-color: #FFF8E1;
  border-radius: 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8D6E63;
}

.video-link {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid #FB7299;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #FB7299;
  background-color: #FFF0F4;
}

.video-link:active {
  background-color: #FB7299;
  color: #FFFFFF;
}

/* ==================== 表单行 ==================== */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F8F4EF;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #3E2723;
  flex-shrink: 0;
}

.form-picker {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.picker-value {
  font-size: 28rpx;
  color: #6F4E37;
  font-weight: 500;
  padding: 8rpx 16rpx;
  background-color: #F5F0E8;
  border-radius: 8rpx;
  text-align: right;
}


/* ==================== 计算结果卡片 ==================== */
.result-card {
  background: linear-gradient(135deg, #6F4E37 0%, #8D6E63 100%);
}

.result-card .card-title {
  color: #F5F5DC;
  border-bottom-color: rgba(245, 245, 220, 0.2);
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.result-item {
  flex: 1;
  min-width: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
}

.result-item-full {
  flex-basis: 100%;
  min-width: 100%;
}

.result-label {
  font-size: 24rpx;
  color: rgba(245, 245, 220, 0.7);
  margin-bottom: 8rpx;
}

.result-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #F5F5DC;
}

.result-value-large {
  font-size: 48rpx;
}

/* ==================== 阶段预览 ==================== */
.stage-preview {
  margin-top: 24rpx;
  padding: 20rpx;
  background-color: #FDFBF7;
  border-radius: 12rpx;
}

.stage-preview-title {
  font-size: 24rpx;
  color: #8D6E63;
  margin-bottom: 12rpx;
}

.stage-preview-item {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
  gap: 12rpx;
}

.stage-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #6F4E37;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.stage-preview-text {
  font-size: 24rpx;
  color: #5D4037;
  line-height: 1.6;
}

/* ==================== 底部固定悬浮按钮（配置视图） ==================== */
.action-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  padding: 32rpx 32rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #FAF7F2 0%, #FAF7F2 60%, rgba(250, 247, 242, 0) 100%);
  display: flex;
  justify-content: center;
  box-sizing: border-box;
}

.btn-start {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  background: #6F4E37;
  color: #F5F5DC;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 16rpx rgba(111, 78, 55, 0.3);
}

.btn-start:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-start-icon {
  font-size: 28rpx;
}

/* ==================== 冲煮计时视图 ==================== */
.brew-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  padding-bottom: 60rpx;
  background-color: #FAF7F2;
}

/* 计时器区域 */
.timer-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx 0;
}

.timer-label {
  font-size: 26rpx;
  color: #8D6E63;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.timer-display {
  font-size: 120rpx;
  font-weight: 300;
  color: #4A3018;
  font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
  letter-spacing: 8rpx;
  text-shadow: 0 4rpx 12rpx rgba(74, 48, 24, 0.1);
}

/* 当前阶段卡片 */
.stage-card {
  width: 100%;
  margin-bottom: 20rpx;
  position: relative;
  text-align: center;
  box-sizing: border-box;
}

.stage-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  background-color: #6F4E37;
  color: #F5F5DC;
  font-size: 22rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.stage-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #3E2723;
  margin-bottom: 16rpx;
}

.stage-info-row {
  margin-bottom: 20rpx;
}

.stage-info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stage-info-label {
  font-size: 24rpx;
  color: #8D6E63;
}

.stage-info-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #5D4037;
}

/* 目标水量 */
.target-water-area {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 24rpx 0;
  margin: 0 32rpx;
  background-color: #FDF8F2;
  border-radius: 16rpx;
  gap: 8rpx;
}

.target-water-label {
  font-size: 24rpx;
  color: #8D6E63;
}

.target-water-value {
  font-size: 72rpx;
  font-weight: 800;
  color: #6F4E37;
  line-height: 1;
}

.target-water-unit {
  font-size: 32rpx;
  color: #6F4E37;
  font-weight: 600;
}

/* 阶段提示 */
.stage-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding: 16rpx;
  background-color: #FFFBF0;
  border-radius: 12rpx;
  gap: 8rpx;
}

.stage-hint-icon {
  font-size: 28rpx;
}

.stage-hint-text {
  font-size: 26rpx;
  color: #6F4E37;
  line-height: 1.5;
}

/* 阶段概览 */
.stages-overview {
  width: 100%;
  flex: 1;
  overflow-y: auto;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.overview-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F0E8;
  gap: 16rpx;
  opacity: 0.6;
  transition: opacity 0.3s;
}

.overview-item:last-child {
  border-bottom: none;
}

.overview-active {
  opacity: 1;
}

.overview-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #D7CCC8;
  flex-shrink: 0;
  transition: all 0.3s;
}

.dot-active {
  background-color: #6F4E37;
  box-shadow: 0 0 0 6rpx rgba(111, 78, 55, 0.15);
  width: 20rpx;
  height: 20rpx;
}

.overview-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.overview-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #3E2723;
}

.overview-detail {
  font-size: 22rpx;
  color: #8D6E63;
}

.overview-time {
  font-size: 22rpx;
  color: #8D6E63;
}

/* ==================== 操作区域（计时视图内） ==================== */
.action-area {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 40rpx 0;
}

/* 结束按钮 */
.btn-end {
  width: 400rpx;
  height: 96rpx;
  background-color: #FFFFFF;
  color: #C0392B;
  font-size: 34rpx;
  font-weight: 600;
  border: 3rpx solid #E8D5D5;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(192, 57, 43, 0.08);
  transition: transform 0.2s;
}

.btn-end:active {
  transform: scale(0.96);
}
